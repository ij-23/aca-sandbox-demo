# Non-secret application settings. The Copilot PAT belongs only in the Sandbox Group.
TENANT_ID=
API_CLIENT_ID=
SPA_CLIENT_ID=
AUTHORIZED_USERS=
ALLOWED_REPOSITORIES=
PUBLIC_ORIGIN=
STORAGE_ACCOUNT=
MANAGED_IDENTITY_CLIENT_ID=
SUBSCRIPTION_ID=
RESOURCE_GROUP=
SANDBOX_GROUP=
CREDENTIAL_CONNECTION_ID=00000000-0000-0000-0000-000000000000
REGION=swedencentral
PUBLICATION_OWNER=
LIVE_EXECUTION_ENABLED=false
MAX_RUN_SECONDS=900
EVENT_RETENTION_LIMIT=10000
# Enable only after real same-PAT publication capability verification.
PUBLICATION_ENABLED=false
# Proposed runtime policy; must pass a live Copilot/clone/dependency test.
SANDBOX_EGRESS_HOSTS=github.com,*.github.com,*.githubusercontent.com,*.githubcopilot.com,default.exp-tas.com,pypi.org,files.pythonhosted.org,registry.npmjs.org

# Non-secret JSON output: terraform output -json sandbox_telemetry_config
SANDBOX_TELEMETRY_CONFIG=
