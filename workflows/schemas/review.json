{
  "$defs": {
    "Check": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 100,
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "passed",
            "failed",
            "skipped",
            "timed_out"
          ],
          "title": "Status",
          "type": "string"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "detail": {
          "default": "",
          "maxLength": 4000,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status",
        "duration_ms"
      ],
      "title": "Check",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "title": "Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "category": {
          "maxLength": 100,
          "title": "Category",
          "type": "string"
        },
        "file": {
          "maxLength": 250,
          "title": "File",
          "type": "string"
        },
        "line": {
          "minimum": 1,
          "title": "Line",
          "type": "integer"
        },
        "evidence": {
          "maxLength": 2000,
          "title": "Evidence",
          "type": "string"
        },
        "explanation": {
          "maxLength": 2000,
          "title": "Explanation",
          "type": "string"
        },
        "recommendation": {
          "maxLength": 2000,
          "title": "Recommendation",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "verification_status": {
          "enum": [
            "verified",
            "unverified",
            "rejected"
          ],
          "title": "Verification Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "severity",
        "category",
        "file",
        "line",
        "evidence",
        "explanation",
        "recommendation",
        "confidence",
        "verification_status"
      ],
      "title": "Finding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "commit_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Commit Sha",
      "type": "string"
    },
    "status": {
      "enum": [
        "pending",
        "running",
        "passed",
        "failed",
        "skipped",
        "timed_out"
      ],
      "title": "Status",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "maxItems": 100,
      "title": "Findings",
      "type": "array"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/Check"
      },
      "maxItems": 100,
      "title": "Checks",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "commit_sha",
    "status",
    "findings",
    "checks",
    "limitations"
  ],
  "title": "ReviewReport",
  "type": "object"
}
