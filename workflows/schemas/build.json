{
  "$defs": {
    "Check": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 100,
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "passed",
            "failed",
            "skipped",
            "timed_out"
          ],
          "title": "Status",
          "type": "string"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "detail": {
          "default": "",
          "maxLength": 4000,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status",
        "duration_ms"
      ],
      "title": "Check",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "commit_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Commit Sha",
      "type": "string"
    },
    "status": {
      "enum": [
        "pending",
        "running",
        "passed",
        "failed",
        "skipped",
        "timed_out"
      ],
      "title": "Status",
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/Check"
      },
      "maxItems": 100,
      "title": "Checks",
      "type": "array"
    },
    "tests_passed": {
      "minimum": 0,
      "title": "Tests Passed",
      "type": "integer"
    },
    "tests_failed": {
      "minimum": 0,
      "title": "Tests Failed",
      "type": "integer"
    },
    "tests_skipped": {
      "minimum": 0,
      "title": "Tests Skipped",
      "type": "integer"
    },
    "health": {
      "enum": [
        "pending",
        "running",
        "passed",
        "failed",
        "skipped",
        "timed_out"
      ],
      "title": "Health",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "commit_sha",
    "status",
    "checks",
    "tests_passed",
    "tests_failed",
    "tests_skipped",
    "health",
    "limitations"
  ],
  "title": "BuildReport",
  "type": "object"
}
